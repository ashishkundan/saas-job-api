// Dev environment. The API image comes from API_IMAGE (by digest):
//   API_IMAGE=acrcv360dev.azurecr.io/saas-job-api@sha256:... \
//     az deployment sub create -l australiaeast -f infra/azure/main.bicep -p infra/azure/dev.bicepparam
using 'main.bicep'

param env = 'dev'
param location = 'australiaeast'
param apiImage = readEnvironmentVariable('API_IMAGE', '')

// Generated by bootstrap-secrets.sh into the application Key Vault; read at
// deployment time (the vault allows template deployments), never typed.
param postgresAdminPassword = az.getSecret(
  '5b69e8d9-2842-44ff-99eb-55eb9836576d', 'rg-cv360-security-dev', 'kv-cv360-dev', 'postgres-admin-password')
