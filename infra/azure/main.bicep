// SaaS Job API on Azure (dev): Container Apps + PostgreSQL Flexible Server,
// private networking, secrets in Key Vault. Deployed at subscription scope
// into the existing resource groups (rg-cv360-<area>-<env>).
//
//   az deployment sub create -l australiaeast -f infra/azure/main.bicep \
//     -p infra/azure/dev.bicepparam
//
// See infra/azure/README.md for the first-time order (secrets, image, deploy,
// migrate) and what each piece costs.
targetScope = 'subscription'

@description('Short environment name used in resource names.')
param env string = 'dev'
param location string = 'australiaeast'

@description('API container image, by digest: <acr>.azurecr.io/saas-job-api@sha256:...')
param apiImage string

@description('Existing Azure Container Registry (in the app resource group).')
param acrName string = 'acrcv360${env}'

@description('Existing Key Vault for application secrets (in the security resource group).')
param appKeyVaultName string = 'kv-cv360-${env}'

@description('PostgreSQL administrator login. Its password is generated by infra/azure/bootstrap-secrets.sh and read from Key Vault, never passed here.')
param postgresAdminLogin string = 'cvadmin'

@secure()
@description('PostgreSQL administrator password (from Key Vault secret postgres-admin-password, via the parameters file).')
param postgresAdminPassword string

@description('API replicas: min stays 1 so the in-process scheduler keeps running.')
param minReplicas int = 1
param maxReplicas int = 2

var names = {
  network: 'rg-cv360-network-${env}'
  data: 'rg-cv360-data-${env}'
  security: 'rg-cv360-security-${env}'
  app: 'rg-cv360-app-${env}'
  monitor: 'rg-cv360-monitor-${env}'
}

module network 'modules/network.bicep' = {
  name: 'cv360-network'
  scope: resourceGroup(names.network)
  params: { env: env, location: location }
}

module monitor 'modules/monitor.bicep' = {
  name: 'cv360-monitor'
  scope: resourceGroup(names.monitor)
  params: { env: env, location: location }
}

module data 'modules/data.bicep' = {
  name: 'cv360-data'
  scope: resourceGroup(names.data)
  params: {
    env: env
    location: location
    subnetId: network.outputs.postgresSubnetId
    privateDnsZoneId: network.outputs.postgresDnsZoneId
    adminLogin: postgresAdminLogin
    adminPassword: postgresAdminPassword
  }
}

module security 'modules/security.bicep' = {
  name: 'cv360-security'
  scope: resourceGroup(names.security)
  params: {
    env: env
    location: location
    keyVaultName: appKeyVaultName
    privateEndpointSubnetId: network.outputs.privateEndpointSubnetId
    keyVaultDnsZoneId: network.outputs.keyVaultDnsZoneId
    databaseUrl: 'postgresql://${postgresAdminLogin}:${uriComponent(postgresAdminPassword)}@${data.outputs.fqdn}:5432/${data.outputs.databaseName}?sslmode=require'
  }
}

module app 'modules/app.bicep' = {
  name: 'cv360-app'
  scope: resourceGroup(names.app)
  params: {
    env: env
    location: location
    apiImage: apiImage
    acrName: acrName
    infrastructureSubnetId: network.outputs.containerAppsSubnetId
    logAnalyticsWorkspaceId: monitor.outputs.workspaceId
    identityId: security.outputs.apiIdentityId
    identityPrincipalId: security.outputs.apiIdentityPrincipalId
    keyVaultUri: security.outputs.keyVaultUri
    minReplicas: minReplicas
    maxReplicas: maxReplicas
  }
}

output apiUrl string = app.outputs.apiUrl
output migrationJobName string = app.outputs.migrationJobName
output postgresFqdn string = data.outputs.fqdn
